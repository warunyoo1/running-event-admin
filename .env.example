# คัดลอกเป็น .env.local (ห้าม commit)
# URL ของ API จริง ใช้เฉพาะฝั่ง server ของ Next (rewrites /api/* -> API)
# ตั้งค่านี้แล้วต้อง restart / build ใหม่
# ใน Docker ค่านี้คือ build arg (ฝังตอน build): compose ใช้ค่านี้จาก environment/.env,
# CI ใช้ GitHub variable API_PROXY_TARGET (production: https://api.walkruntogive2027.com)
API_PROXY_TARGET=http://14.207.142.107:4000

# port บน host ที่ container admin bind (127.0.0.1 เท่านั้น) ใช้กับ docker-compose*.yml
ADMIN_HOST_PORT=3000
